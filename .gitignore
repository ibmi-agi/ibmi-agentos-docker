# =========================
# Python
# =========================
__pycache__/
*.py[codz]
*$py.class

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking / linting
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.ruff_cache/
.cache

# =========================
# Virtual envs + secrets
# =========================
.venv/
venv/
env/
ENV/
.env
.env.production
.envrc

# Local secrets / keys
secrets/

# =========================
# Jupyter / notebooks
# =========================
.ipynb_checkpoints/

# =========================
# IDEs / editors
# =========================
.idea/
.vscode/

# =========================
# OS cruft
# =========================
.DS_Store
Thumbs.db

# =========================
# Project-specific
# =========================
tmp

# Project-scoped ibmi CLI connections (created by /setup-platform). The nearest
# .ibmi/config.yaml wins over ~/.ibmi/config.yaml, so connections added inside
# this repo stay sandboxed to it — and stay out of git: the config names real
# hosts/users even though passwords resolve via ${DB2i_*} env references.
.ibmi/

# Coding-agent config: the vendor-neutral skills live in .agents/skills/
# (committed); .claude/skills is a committed symlink into it, and
# .claude/settings.json ships shared permissions. Everything else under
# .claude/ (local settings, other agents' state) stays local.
.claude/*
!.claude/skills
!.claude/settings.json

# Optional: local PyPI creds (uncomment if you ever create it)
# .pypirc
