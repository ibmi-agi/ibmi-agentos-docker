# =============================================================================
# Required — at least one model provider key
# =============================================================================
# The template defaults to anthropic:claude-sonnet-4-6. Set ANTHROPIC_API_KEY,
# or change DEFAULT_MODEL_ID below to a provider you've keyed.
ANTHROPIC_API_KEY=sk-ant-***

# =============================================================================
# Model selection — single switch for every agent
# =============================================================================
# Format: provider:model-id. Supports every Agno-supported provider.
#   anthropic:claude-sonnet-4-6   (default)
#   anthropic:claude-haiku-4-5
#   openai:gpt-4o
#   google:gemini-2.0-flash
#   groq:llama-3.3-70b-versatile
#   ollama:llama3.3
# DEFAULT_MODEL_ID=anthropic:claude-sonnet-4-6

# =============================================================================
# IBM i target system — required for agents to do real work
# =============================================================================
# The ibmi-mcp-server reads these and uses them to open Db2 for i connections.
# DB2i_HOST is the IBM i hostname or IP; DB2i_USER/DB2i_PASS is a valid profile.
DB2i_HOST=your-ibmi-host
DB2i_USER=your-ibmi-user
DB2i_PASS=your-ibmi-password
# DB2i_PORT=8076   # default; only override if your system uses a non-standard port

# =============================================================================
# IBM i MCP server — version and URL
# =============================================================================
# Image tag for ghcr.io/ibm/ibmi-mcp-server. Pin to a known-good version.
MCP_SERVER_VERSION=v0.5.1

# In Docker compose: agentos-api reaches the server at this URL.
# For local CLI work, cli.py overrides this to http://localhost:3010/mcp.
# MCP_URL=http://ibmi-mcp-server:3010/mcp

# =============================================================================
# Web research (optional) — Parallel.ai
# =============================================================================
#   PARALLEL_API_KEY set  →  authenticated /mcp endpoint (higher rate ceiling)
#   unset                 →  keyless /mcp endpoint (fine for dev)
# PARALLEL_API_KEY=

# =============================================================================
# Optional multi-user MCP auth
# =============================================================================
# When AUTH_ENABLED=true, the template's auth/ middleware activates:
#   - API key bearer-token enforcement on every request
#   - Per-user IBM i credentials stored in Postgres (encrypted)
#   - RSA + AES-256-GCM credential handoff to the MCP server
# Requires running with compose.auth.yaml overlay. See docs/auth-optional.md.
# AUTH_ENABLED=false

# =============================================================================
# Production — JWT verification for AgentOS RBAC
# =============================================================================
# AgentOS enables RBAC whenever RUNTIME_ENV=prd (the default outside dev).
# Without this key, prod refuses to serve traffic. Generate the keypair at
# os.agno.com (your OS → Settings → Token Based Authorization).
# Set `authorization=False` in app/main.py to opt out (not recommended).
# JWT_VERIFICATION_KEY=-----BEGIN PUBLIC KEY-----
# MIIBIjANBgkq...
# -----END PUBLIC KEY-----

# =============================================================================
# AgentOS scheduler base URL
# =============================================================================
# Defaults to http://127.0.0.1:8000 for local development. When deployed
# to a different domain (e.g. Railway), set this to the public URL.
# AGENTOS_URL=http://127.0.0.1:8000

# =============================================================================
# Database — defaults match docker compose
# =============================================================================
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=ai
# DB_PASS=ai
# DB_DATABASE=ai
# DB_DRIVER=postgresql+psycopg

# =============================================================================
# Alternate model providers (set these when you change DEFAULT_MODEL_ID)
# =============================================================================
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OPENAI_BASE_URL=     # for self-hosted OpenAI-compatible endpoints
