# =============================================================================
# Required — at least one model provider key
# =============================================================================
# Agents default to anthropic:claude-sonnet-4-5. Set ANTHROPIC_API_KEY, or
# change AGENT_MODEL below to a provider you've keyed.
ANTHROPIC_API_KEY=sk-ant-***

# =============================================================================
# Model selection — single switch for every agent
# =============================================================================
# Format: provider:model-id. Supports every Agno-supported provider.
#   anthropic:claude-sonnet-4-5   (default for main agents)
#   anthropic:claude-haiku-4-5
#   openai:gpt-4o
#   google:gemini-2.0-flash
#   groq:llama-3.3-70b-versatile
#   ollama:llama3.3
# AGENT_MODEL=anthropic:claude-sonnet-4-5
# AGENT_TEAM_MEMBER_MODEL=anthropic:claude-haiku-4-5

# =============================================================================
# IBM i target system — required for the agents to do real work
# =============================================================================
# The ibmi-mcp-server reads these to open Db2 for i connections.
# DB2i_HOST is the IBM i hostname or IP; DB2i_USER/DB2i_PASS is a valid profile.
DB2i_HOST=your-ibmi-host
DB2i_USER=your-ibmi-user
DB2i_PASS=your-ibmi-password
# DB2i_PORT=8076   # default; only override for a non-standard Mapepire port

# =============================================================================
# IBM i MCP server — image version
# =============================================================================
# Image tag for ghcr.io/ibm/ibmi-mcp-server. Pin to a known-good version.
MCP_SERVER_VERSION=v0.5.1

# In Docker compose, agentos-api reaches the server at this URL.
# MCP_URL=http://ibmi-mcp-server:3010/mcp

# =============================================================================
# Web research — Parallel (wired via agents/utils/web_context.py)
# =============================================================================
# Every agent gets a `query_web(question)` tool that routes through a
# synthesizing sub-agent over Parallel's MCP endpoint. Optional key:
#   PARALLEL_API_KEY set  ->  authenticated endpoint (higher rate ceiling)
#   unset                 ->  keyless endpoint (fine for dev)
# PARALLEL_API_KEY=

# =============================================================================
# Agentic memory embeddings (optional)
# =============================================================================
# Agents enable agentic memory; semantic memory recall uses an OpenAI embedder
# when OPENAI_API_KEY is set.
# OPENAI_API_KEY=

# =============================================================================
# Database — defaults match docker compose
# =============================================================================
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=ai
# DB_PASS=ai
# DB_DATABASE=ai
# DB_DRIVER=postgresql+psycopg

# =============================================================================
# Alternate model providers (set when you change AGENT_MODEL)
# =============================================================================
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OPENAI_BASE_URL=     # for self-hosted OpenAI-compatible endpoints
